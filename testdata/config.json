{
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local",
        "prefer_go": true
      }
    ],
    "final": "dns-local",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "shadowsocks",
      "tag": "SS-aes128-in-6607",
      "listen": "::",
      "listen_port": 6607,
      "method": "aes-128-gcm",
      "password": "FAKE-config-inbound-password-ok"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "ai",
      "server": "198.51.100.102",
      "server_port": 27562,
      "version": "5",
      "username": "fakeuser",
      "password": "fakepass"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "example.com",
          "example.org"
        ],
        "outbound": "ai"
      }
    ],
    "final": "direct",
    "default_domain_resolver": {
      "server": "dns-local",
      "strategy": "prefer_ipv4"
    }
  }
}
